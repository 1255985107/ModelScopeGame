  - characterName: "\u767DAda"
    dialogText: "\u6B22\u8FCE\u56DE\u6765\uFF0C\u5B69\u5B50\u3002\u4F60\u7684\u65C5\u7A0B\u2026\u4E00\u5B9A\u5F88\u4E0D\u5BB9\u6613\u3002"
