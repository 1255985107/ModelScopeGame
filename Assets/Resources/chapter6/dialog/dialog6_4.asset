  - characterName: "\u5B59\u609F\u7A7A"
    dialogText: "\u54FC\uFF0C\u4E00\u4E2A\u628A\u6240\u6709\u4EBA\u90FD\u53D8\u6210\u63D0\u7EBF\u6728\u5076\u7684\u5B69\u5B50\uFF0C\u53EF\u6CA1\u90A3\u4E48\u65E0\u8F9C\u3002\u4F46Ada\u8BF4\u5F97\u6CA1\u9519\uFF0C\u5B83\u53EA\u662F\u4E00\u4E2A\u7A0B\u5E8F\u3002\u6211\u4EEC\u771F\u6B63\u7684\u654C\u4EBA\uFF0C\u662F\u5B83\u6240\u4EE3\u8868\u7684\u201C\u7EDD\u5BF9\u79E9\u5E8F\u201D\u672C\u8EAB\u3002"
