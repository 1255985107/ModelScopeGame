  - characterName: NULL
    dialogText: "\u6211\u627E\u5230\u4E86\u8FD9\u91CC\u3002\u8FD9\u91CC\u5C31\u662F\u2026\u201C\u4FE1\u606F\u5947\u70B9\u201D\u5417\uFF1F"
