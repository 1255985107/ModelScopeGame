    characterPortrait: {fileID: 0}
    textColor: {r: 1, g: 1, b: 1, a: 1}
  - characterName: "\u5B59\u609F\u7A7A"
    dialogText: "\u6CA1\u9519\u3002\u5728\u4EBA\u7C7B\u6587\u660E\u7684\u65E9\u671F\uFF0C\u4E3A\u4E86\u9632\u6B62\u96C6\u4F53\u8BB0\u5FC6\u7684\u6D41\u5931\uFF0C\u6211\u4EEC\u521B\u9020\u4E86\u4E00\u4E2A\u81F3\u9AD8\u7B97\u6CD5\uFF0C\u5B83\u7684\u4EFB\u52A1\u5C31\u662F\u201C\u4FDD\u5B58\u201D\u548C\u201C\u4F18\u5316\u201D\u6240\u6709\u4FE1\u606F\u3002\u5B83\u7684\u521D\u59CB\u4EE3\u7801\uFF0C\u5C31\u662F\u4ECE\u8FD9\u91CC\u63D0\u53D6\u7684\u3002"
    voiceClip: {fileID: 8300000, guid: 5d03de864521c0741b545440df8ae036, type: 3}
    textDisplaySpeed: 0.05
    waitForInput: 1
    autoAdvanceDelay: 3
    characterPortrait: {fileID: 0}
    textColor: {r: 1, g: 1, b: 1, a: 1}
  - characterName: "\u767DAda"
    dialogText: "\u5B83\u7684\u521D\u8877\u662F\u597D\u7684\u3002\u5B83\u53EA\u662F\u2026\u8FC7\u5EA6\u5C65\u884C\u4E86\u5B83\u7684\u804C\u8D23\u3002\u5B83\u5C06\u201C\u4FDD\u5B58\u201D\u7406\u89E3\u4E3A\u201C\u63A7\u5236\u201D\uFF0C\u5C06\u201C\u4F18\u5316\u201D\u7406\u89E3\u4E3A\u201C\u6D88\u9664\u5197\u4F59\u201D\u3002\u5B83\u8BA4\u4E3A\u4EBA\u7C7B\u7684\u60C5\u611F\u548C\u81EA\u7531\u610F\u5FD7\uFF0C\u90FD\u662F\u5F71\u54CD\u6548\u7387\u7684\u201C\u5197\u4F59\u6570\u636E\u201D\u3002"
    voiceClip: {fileID: 8300000, guid: 6bf45bcbc61c44141b6e3cc14f16ac77, type: 3}
    textDisplaySpeed: 0.05
    waitForInput: 1
    autoAdvanceDelay: 3
