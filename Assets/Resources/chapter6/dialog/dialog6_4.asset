    textDisplaySpeed: 0.05
    waitForInput: 1
    autoAdvanceDelay: 3
    characterPortrait: {fileID: 0}
    textColor: {r: 1, g: 1, b: 1, a: 1}
  - characterName: "\u5B59\u609F\u7A7A"
    dialogText: "\u6CA1\u9519\u3002\u8FD9\u91CC\u5C31\u662F\u201C\u82B1\u679C\u5C71\u201D\u3002\u5728\u201C\u5929\u9053\u201D\u8BDE\u751F\u4E4B\u524D\uFF0C\u8FD9\u91CC\u662F\u4EBA\u7C7B\u96C6\u4F53\u610F\u8BC6\u6700\u539F\u59CB\u3001\u6700\u7EAF\u7CB9\u7684\u5907\u4EFD\u3002\u4E00\u4E2A\u6CA1\u6709\u88AB\u7B97\u6CD5\u6C61\u67D3\u7684\uFF0C\u771F\u6B63\u7684\u201C\u4E50\u56ED\u201D\u3002"
    voiceClip: {fileID: 8300000, guid: 007d964c7434c8940bcd72eebb1e737c, type: 3}
    textDisplaySpeed: 0.05
    waitForInput: 1
    autoAdvanceDelay: 3
    characterPortrait: {fileID: 0}
    textColor: {r: 1, g: 1, b: 1, a: 1}
  - characterName: "\u767DAda"
    dialogText: " \u4F46\u5B83\u4E5F\u66FE\u662F\u201C\u5929\u9053\u201D\u8BDE\u751F\u7684\u6447\u7BEE\u3002"
